menu "Wirelink"

config WIRELINK
	bool "Enable Wirelink protocol library"
	default y
	help
	  Build the platform-independent Wirelink protocol core. Transport adapters
	  are opt-in so the core can be shared by Zephyr, bare-metal, and other RTOS
	  projects.

if WIRELINK

choice WIRELINK_LINK_PROFILE
	prompt "Core link capability"
	default WIRELINK_LINK_PROFILE_MULTI
	help
	  Select the envelopes and integrity modes compiled into the core.

config WIRELINK_LINK_PROFILE_MULTI
	bool "All envelopes and integrity modes"
	help
	  Allow endpoints with different link configurations in one firmware.

config WIRELINK_LINK_PROFILE_COBS_CRC16
	bool "COBS stream with CRC16 only"
	help
	  Specialize actual DATA, ACK, retry and RX paths for COBS + CRC16.
	  Other valid configurations return WL_ERR_NOT_SUPPORTED. Standalone
	  CRC and COBS tools remain available. Reliable delivery is supported.

endchoice

config WIRELINK_PLATFORM
	bool "Enable the native clock/session environment"
	select CSPRNG_NEEDED
	help
	  Provide default endpoint time and random instance identities. Without a
	  real CSPRNG, identity acquisition fails; applications can inject their
	  own source instead. Does not use the insecure testing generator.

config WIRELINK_STORAGE
	bool "Enable the optional fixed-block endpoint allocator"
	help
	  Creates generated endpoints in caller-supplied fixed pools. No heap
	  fallback and no allocations during protocol operation.

config WIRELINK_ZEPHYR_WAIT
	bool "Enable the Zephyr owner-task RPC waiter"
	depends on MULTITHREADING
	help
	  Static semaphore-based activity and stop notifications for generated
	  synchronous RPCs. Creates no thread and does no periodic polling.

config WIRELINK_ZEPHYR_UART_DMA
	bool "Enable the Zephyr asynchronous UART adapter"
	depends on SERIAL
	depends on UART_ASYNC_API
	help
	  Build Wirelink's full-duplex Zephyr UART adapter. The adapter owns the
	  UART asynchronous callback, receives directly into the Wirelink SPSC
	  ring, and exposes the UART TX path as the Wirelink sink.

config WIRELINK_ZEPHYR_USB_BULK
	bool "Enable the Zephyr USB vendor bulk adapter"
	depends on USB_DEVICE_STACK_NEXT
	help
	  Build Wirelink's full-duplex custom USB Bulk class. The UDC receives
	  directly into one Wirelink ring claim. USB completion callbacks only
	  publish ownership and completion state; the main loop performs protocol
	  work and re-arms endpoint requests.

config WIRELINK_ZEPHYR_UART_POLL_EXPERIMENTAL
	bool "Enable experimental physical UART polling adapter"
	depends on SERIAL && MULTITHREADING
	help
	  Caller-owned static RX thread, 64-byte batches and one-tick interruptible
	  sleeps, with synchronous polling TX. Memory-consumed completion only.
	  No hardware flow control or CDC support; production default is unchanged.

config WIRELINK_ZEPHYR_UART_IRQ
	bool "Enable the Zephyr interrupt-driven UART adapter"
	depends on SERIAL
	depends on UART_INTERRUPT_DRIVEN
	help
	  Build Wirelink's interrupt-driven UART adapter. It is the low-latency
	  fallback for USB CDC ACM devices and UART controllers without an async
	  DMA implementation. RX FIFO bytes are written directly into the SPSC
	  ring and all protocol processing remains in the consumer loop.

config WIRELINK_ZEPHYR_UART_IRQ_TIMING
	bool "Collect UART adapter callback timing diagnostics"
	depends on WIRELINK_ZEPHYR_UART_IRQ
	help
	  Count valid driver callbacks and elapsed cycles inside the callback.
	  These counts differ from RX/TX ready-source processing counts. Timing
	  excludes the driver ISR and callback lock acquisition/release. Counters
	  wrap at 32 bits; sample deltas within one counter wrap. Disabled builds
	  have no additional timing reads, counters or callback work.

config WIRELINK_ZEPHYR_UART_IRQ_NOTIFICATION_DIAGNOSTICS
	bool "Collect UART notification diagnostics"
	depends on WIRELINK_ZEPHYR_UART_IRQ
	help
	  Count publication wake attempts, callback semaphore gives, service latch
	  acknowledgements and waiter entries. For separate diagnostic builds only;
	  disabled builds have no extra counters or notification work. Gives are
	  attempts, not semaphore transitions or delivered business events.

config WIRELINK_ZEPHYR_UDP
	bool "Enable the Zephyr native IPv4 UDP socket adapter"
	depends on MULTITHREADING && NET_SOCKETS && NET_NATIVE_IPV4 && NET_NATIVE_UDP
	depends on !NET_SOCKETS_OFFLOAD
	select ZVFS_EVENTFD
	help
	  Single-owner native-packet UDP with static RX slots and combined socket/
	  eventfd waiting. Attaches to default endpoints; no background thread or
	  adapter heap. Each instance needs one socket and one eventfd. Notifications
	  are thread-only. Configure the network interface and resource pools in the
	  application; offloaded sockets and COBS are not supported by this adapter.

config WIRELINK_ZEPHYR_UDP_TIMING
	bool "Collect UDP adapter elapsed-cycle diagnostics"
	depends on WIRELINK_ZEPHYR_UDP
	help
	  Opt-in call counts, total and maximum elapsed cycles for actual socket
	  sends, receives and owner receive service. Uses k_cycle_get_32, not the
	  endpoint clock. Includes preemption and stack waiting; it is not CPU
	  accounting. Each measured interval must be shorter than one counter wrap.
	  Disabled builds have no timing reads or timing storage.

endif

endmenu
