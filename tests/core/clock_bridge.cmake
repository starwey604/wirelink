add_library(wirelink_clock_bridge SHARED ${CMAKE_CURRENT_LIST_DIR}/clock_bridge.c ${CMAKE_CURRENT_LIST_DIR}/native_clock.cpp)
target_compile_definitions(wirelink_clock_bridge PRIVATE CLOCK_BRIDGE_BUILD)
target_link_libraries(wirelink_clock_bridge PRIVATE calculator_fixture_protocol Wirelink::packet_loopback)
target_compile_features(wirelink_clock_bridge PRIVATE cxx_std_20)
target_include_directories(wirelink_clock_bridge PRIVATE runtime/host/include examples/common)
add_executable(wirelink_clock_bridge_cpp ${CMAKE_CURRENT_LIST_DIR}/clock_consumer.cpp)
target_compile_features(wirelink_clock_bridge_cpp PRIVATE cxx_std_20)
target_link_libraries(wirelink_clock_bridge_cpp PRIVATE wirelink_clock_bridge)
add_test(NAME wirelink_clock_bridge_cpp COMMAND wirelink_clock_bridge_cpp)
add_test(NAME wirelink_clock_bridge_python COMMAND ${Python3_EXECUTABLE}
  ${CMAKE_CURRENT_LIST_DIR}/clock_consumer.py $<TARGET_FILE:wirelink_clock_bridge>)
set_tests_properties(wirelink_clock_bridge_cpp wirelink_clock_bridge_python PROPERTIES TIMEOUT 10)
add_executable(wirelink_clock_benchmark ${CMAKE_CURRENT_LIST_DIR}/clock_benchmark.cpp)
target_link_libraries(wirelink_clock_benchmark PRIVATE wirelink_clock_bridge)
target_compile_features(wirelink_clock_benchmark PRIVATE cxx_std_20)
foreach(target wirelink_clock_bridge wirelink_clock_bridge_cpp wirelink_clock_benchmark)
  wl_warnings(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
endforeach()
