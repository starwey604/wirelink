{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wirelink-docs",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "docs.silkenkite.ink",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
