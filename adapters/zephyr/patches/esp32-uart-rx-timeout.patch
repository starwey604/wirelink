+/* Validate the requested format before changing format registers or FIFOs. */
+static int uart_esp32_validate_rx_timeout(struct uart_esp32_data *data,
+					const struct uart_config *cfg)
+{
+	uint32_t symbol_bits = 1U;
+	uint16_t max_threshold;
+
+	switch (cfg->data_bits) {
+	case UART_CFG_DATA_BITS_5:
+		symbol_bits += 5U;
+		break;
+	case UART_CFG_DATA_BITS_6:
+		symbol_bits += 6U;
+		break;
+	case UART_CFG_DATA_BITS_7:
+		symbol_bits += 7U;
+		break;
+	case UART_CFG_DATA_BITS_8:
+		symbol_bits += 8U;
+		break;
+	default:
+		return -ENOTSUP;
+	}
+
+	switch (cfg->parity) {
+	case UART_CFG_PARITY_NONE:
+		break;
+	case UART_CFG_PARITY_EVEN:
+	case UART_CFG_PARITY_ODD:
+		symbol_bits += 1U;
+		break;
+	default:
+		return -ENOTSUP;
+	}
+
+	switch (cfg->stop_bits) {
+	case UART_CFG_STOP_BITS_1:
+		symbol_bits += 1U;
+		break;
+	case UART_CFG_STOP_BITS_1_5:
+	case UART_CFG_STOP_BITS_2:
+		/* Match HAL rounding for fractional stop bits. */
+		symbol_bits += 2U;
+		break;
+	default:
+		return -ENOTSUP;
+	}
+
+	/* Use the HAL query's SoC/clock-dependent limit with the requested
+	 * format, without modifying the live format to call that query.
+	 */
+	max_threshold = uart_ll_max_tout_thrd(data->hal.dev);
+	if (CONFIG_UART_ESP32_RX_TIMEOUT > max_threshold / symbol_bits) {
+		return -EINVAL;
+	}
+
+	return 0;
+}
