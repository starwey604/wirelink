@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/WirelinkTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WirelinkWlc.cmake")
# Optional wrappers/transports never impose C++ or an OS dependency on C users.
function(_wirelink_load_component component)
  set(Wirelink_${component}_FOUND FALSE PARENT_SCOPE)
  if(TARGET Wirelink::${component})
    set(Wirelink_${component}_FOUND TRUE PARENT_SCOPE)
    return()
  endif()
  if(NOT component MATCHES "^(asio_udp|astrial|astrial_usb|host|cpp|cpp_host)$")
    set(Wirelink_NOT_FOUND_MESSAGE "Unknown Wirelink component: ${component}" PARENT_SCOPE)
    return()
  endif()
  if(NOT CMAKE_CXX_COMPILER_LOADED)
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${component} requires CXX in project LANGUAGES" PARENT_SCOPE)
    return()
  endif()
  set(export_component ${component})
  if(component MATCHES "^(cpp|cpp_host)$")
    foreach(dependency host asio_udp)
      _wirelink_load_component(${dependency})
      if(NOT Wirelink_${dependency}_FOUND)
        set(Wirelink_NOT_FOUND_MESSAGE "${Wirelink_NOT_FOUND_MESSAGE}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    if(NOT TARGET Wirelink::platform)
      set(Wirelink_NOT_FOUND_MESSAGE "Wirelink cpp_host requires the platform component" PARENT_SCOPE)
      return()
    endif()
    set(export_component cpp_host)
  endif()
  set(exports "${CMAKE_CURRENT_LIST_DIR}/Wirelink_${export_component}Targets.cmake")
  if(NOT EXISTS "${exports}")
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${component} was not built/installed" PARENT_SCOPE)
    return()
  endif()
  if(component MATCHES "^astrial" AND NOT TARGET WirelinkBackend::${component})
    if(TARGET ${component})
      add_library(WirelinkBackend::${component} ALIAS ${component})
    else()
      set(Wirelink_NOT_FOUND_MESSAGE
        "Supply ${component} or WirelinkBackend::${component} before finding the Wirelink component" PARENT_SCOPE)
      return()
    endif()
  endif()
  find_package(Threads QUIET)
  if(NOT Threads_FOUND)
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${component} requires Threads" PARENT_SCOPE)
    return()
  endif()
  include("${exports}")
  set(Wirelink_${component}_FOUND TRUE PARENT_SCOPE)
endfunction()
foreach(_wl_component IN LISTS Wirelink_FIND_COMPONENTS)
  _wirelink_load_component(${_wl_component})
endforeach()
check_required_components(Wirelink)
unset(_wl_component)
