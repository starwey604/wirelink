# SPDX-License-Identifier: Apache-2.0
@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/WirelinkTargets.cmake")
# Optional C++ transports do not impose a C++ compiler/backend on C-only users.
foreach(_wl_component IN LISTS Wirelink_FIND_COMPONENTS)
  if(TARGET Wirelink::${_wl_component})
    set(Wirelink_${_wl_component}_FOUND TRUE)
    continue()
  endif()
  set(Wirelink_${_wl_component}_FOUND FALSE)
  if(NOT _wl_component MATCHES "^(asio_udp|astrial|astrial_usb)$")
    set(Wirelink_NOT_FOUND_MESSAGE "Unknown Wirelink component: ${_wl_component}")
    continue()
  endif()
  if(NOT CMAKE_CXX_COMPILER_LOADED)
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${_wl_component} requires CXX in project LANGUAGES")
    continue()
  endif()
  set(_wl_export "${CMAKE_CURRENT_LIST_DIR}/Wirelink_${_wl_component}Targets.cmake")
  if(NOT EXISTS "${_wl_export}")
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${_wl_component} was not built/installed")
    continue()
  endif()
  if(_wl_component MATCHES "^astrial")
    # Upstream Astrial is supplied by the application, without a vendor copy
    # or an invented installed Astrial package. Accept an explicit backend or
    # its real source-tree target, which carries its own system dependencies.
    if(NOT TARGET WirelinkBackend::${_wl_component})
      if(TARGET ${_wl_component})
        add_library(WirelinkBackend::${_wl_component} ALIAS ${_wl_component})
      else()
        set(Wirelink_NOT_FOUND_MESSAGE
          "Supply ${_wl_component} or WirelinkBackend::${_wl_component} before finding the Wirelink component")
        continue()
      endif()
    endif()
  endif()
  find_package(Threads QUIET)
  if(NOT Threads_FOUND)
    set(Wirelink_NOT_FOUND_MESSAGE "Wirelink ${_wl_component} requires Threads")
    continue()
  endif()
  include("${_wl_export}")
  set(Wirelink_${_wl_component}_FOUND TRUE)
endforeach()
check_required_components(Wirelink)
unset(_wl_component)
unset(_wl_export)
