prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@
link_profile=@WIRELINK_LINK_PROFILE@

Name: Wirelink
Description: Allocation-free C11 link protocol engine
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lwirelink
Cflags: -I${includedir}
