include_guard(GLOBAL)
set(WIRELINK_WLC_CODEGEN_CONTRACT "1" CACHE INTERNAL "Generated-code contract" FORCE)

function(_wirelink_wlc_validate_executable executable out_valid out_reason)
  if(NOT EXISTS "${executable}" OR IS_DIRECTORY "${executable}")
    set(${out_valid} FALSE PARENT_SCOPE)
    set(${out_reason} "does not name a file" PARENT_SCOPE)
    return()
  endif()

  execute_process(
    COMMAND "${executable}" codegen-contract
    RESULT_VARIABLE status
    OUTPUT_VARIABLE contract
    ERROR_VARIABLE error
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_STRIP_TRAILING_WHITESPACE
    TIMEOUT 10)
  if(NOT status STREQUAL "0")
    set(${out_valid} FALSE PARENT_SCOPE)
    set(${out_reason} "could not query codegen-contract (exit ${status}): ${error}" PARENT_SCOPE)
  elseif(NOT contract MATCHES "^[0-9]+$")
    set(${out_valid} FALSE PARENT_SCOPE)
    set(${out_reason} "did not report an integer generated-code contract" PARENT_SCOPE)
  elseif(NOT contract STREQUAL WIRELINK_WLC_CODEGEN_CONTRACT)
    set(${out_valid} FALSE PARENT_SCOPE)
    set(${out_reason}
      "provides generated-code contract ${contract}, expected ${WIRELINK_WLC_CODEGEN_CONTRACT}"
      PARENT_SCOPE)
  else()
    set(${out_valid} TRUE PARENT_SCOPE)
    set(${out_reason} "" PARENT_SCOPE)
  endif()
endfunction()

# Rust canonicalize() returns verbatim paths on Windows. CMake/MSBuild dependency
# tracking expects ordinary drive/UNC paths with forward slashes.
function(_wirelink_wlc_windows_dependency_path input out_path)
  string(REPLACE "\\" "/" _path "${input}")
  string(REGEX REPLACE "^//[?]/UNC/" "//" _path "${_path}")
  string(REGEX REPLACE "^//[?]/" "" _path "${_path}")
  set(${out_path} "${_path}" PARENT_SCOPE)
endfunction()

# Resolve imported files at configure time and refresh edges after edits.
function(_wirelink_wlc_schema_dependencies executable schema out_dependencies)
  execute_process(COMMAND "${executable}" dependencies "${schema}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _inputs ERROR_VARIABLE _error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT _result STREQUAL "0")
    message(FATAL_ERROR "Cannot resolve Wirelink schema imports: ${_error}")
  endif()
  string(REPLACE "\r\n" "\n" _inputs "${_inputs}")
  string(REPLACE "\n" ";" _inputs "${_inputs}")
  if(CMAKE_HOST_WIN32)
    set(_normalized_inputs "")
    foreach(_input IN LISTS _inputs)
      _wirelink_wlc_windows_dependency_path("${_input}" _normalized)
      list(APPEND _normalized_inputs "${_normalized}")
    endforeach()
    set(_inputs "${_normalized_inputs}")
  endif()
  # Reconfigure when an import edge changes, then refresh the transitive set.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_inputs})
  set(${out_dependencies} "${_inputs}" PARENT_SCOPE)
endfunction()


# WLC runs on the build host, including when cross-compiling.
function(_wirelink_wlc_find out_compiler out_reason)
  if(WIRELINK_WLC_EXECUTABLE)
    _wirelink_wlc_validate_executable("${WIRELINK_WLC_EXECUTABLE}" valid reason)
    if(NOT valid)
      message(FATAL_ERROR "Invalid WIRELINK_WLC_EXECUTABLE (${WIRELINK_WLC_EXECUTABLE}): ${reason}")
    endif()
    set(${out_compiler} "${WIRELINK_WLC_EXECUTABLE}" PARENT_SCOPE)
    set(${out_reason} "" PARENT_SCOPE)
    return()
  endif()

  set(name wlc)
  if(CMAKE_HOST_WIN32)
    set(name wlc.exe)
  endif()
  find_program(_path_wlc NAMES ${name} PATHS ENV PATH NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH NO_CACHE)
  set(reason "no wlc in the local Cargo release/debug directories or on PATH")
  foreach(candidate IN ITEMS
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../wlc/target/release/${name}"
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../wlc/target/debug/${name}"
      "${_path_wlc}")
    if(EXISTS "${candidate}")
      _wirelink_wlc_validate_executable("${candidate}" valid detail)
      if(valid)
        get_filename_component(compiler "${candidate}" ABSOLUTE)
        set(${out_compiler} "${compiler}" PARENT_SCOPE)
        set(${out_reason} "" PARENT_SCOPE)
        return()
      endif()
      set(reason "${candidate}: ${detail}")
    endif()
  endforeach()
  set(${out_compiler} "" PARENT_SCOPE)
  set(${out_reason} "${reason}" PARENT_SCOPE)
endfunction()

function(_wirelink_wlc_resolve explicit result)
  if(explicit)
    set(WIRELINK_WLC_EXECUTABLE "${explicit}")
  elseif(_wl_wlc)
    set(${result} "${_wl_wlc}" PARENT_SCOPE)
    return()
  endif()
  _wirelink_wlc_find(compiler reason)
  if(NOT compiler)
    message(FATAL_ERROR "Supply a compatible WLC with WIRELINK_WLC_EXECUTABLE: ${reason}")
  endif()
  set(${result} "${compiler}" PARENT_SCOPE)
endfunction()

function(wirelink_wlc_generate)
  cmake_parse_arguments(WLC "ALL_NODES" "TARGET;SCHEMA;NODE;PREVIOUS;OUTPUT_DIR;WLC_EXECUTABLE" "" ${ARGN})
  if(WLC_UNPARSED_ARGUMENTS OR NOT WLC_TARGET OR NOT WLC_SCHEMA OR TARGET "${WLC_TARGET}")
    message(FATAL_ERROR "wirelink_wlc_generate requires a new TARGET and SCHEMA; unknown arguments: ${WLC_UNPARSED_ARGUMENTS}")
  endif()
  if(WLC_NODE AND WLC_ALL_NODES)
    message(FATAL_ERROR "NODE and ALL_NODES are mutually exclusive")
  endif()
  _wirelink_wlc_resolve("${WLC_WLC_EXECUTABLE}" compiler)
  get_filename_component(schema "${WLC_SCHEMA}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
  execute_process(COMMAND "${compiler}" module-name "${schema}"
    RESULT_VARIABLE status OUTPUT_VARIABLE module ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status STREQUAL "0" OR NOT module MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Cannot determine generated C module name: ${error}")
  endif()
  _wirelink_wlc_schema_dependencies("${compiler}" "${schema}" depends)
  list(APPEND depends "${compiler}")
  if(WLC_OUTPUT_DIR)
    get_filename_component(output "${WLC_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
  else()
    set(output "${CMAKE_CURRENT_BINARY_DIR}/wirelink-generated/${WLC_TARGET}")
  endif()
  set(command "${compiler}" compile "${schema}" --out-dir "${output}")
  if(WLC_NODE)
    list(APPEND command --node "${WLC_NODE}")
  elseif(WLC_ALL_NODES)
    list(APPEND command --all-nodes)
  endif()
  if(WLC_PREVIOUS)
    get_filename_component(previous "${WLC_PREVIOUS}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    list(APPEND command --previous "${previous}")
    _wirelink_wlc_schema_dependencies("${compiler}" "${previous}" previous_depends)
    list(APPEND depends ${previous_depends})
  endif()
  # Node framing determines compile-time link dependencies, so inspect the
  # generated manifest during configure and regenerate it after import edits.
  execute_process(COMMAND ${command} RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "WLC node generation failed: ${error}")
  endif()
  set(manifest "${output}/${module}_manifest.json")
  file(READ "${manifest}" metadata)
  string(JSON node_count LENGTH "${metadata}" nodes)
  set(connectors "")
  if(node_count GREATER 0)
    math(EXPR last_node "${node_count} - 1")
    foreach(index RANGE ${last_node})
      string(JSON framing GET "${metadata}" nodes ${index} framing)
      if(framing STREQUAL "cobs_crc16")
        list(APPEND connectors Wirelink::stream_cobs_crc16)
      elseif(framing STREQUAL "length16")
        list(APPEND connectors Wirelink::stream_length16_none)
      endif()
    endforeach()
  endif()
  list(REMOVE_DUPLICATES connectors)
  set(generated "${output}/${module}.c" "${output}/${module}.h" "${manifest}")
  set(verifier "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/WirelinkWlcVerifyManifest.cmake")
  add_custom_command(OUTPUT ${generated}
    COMMAND ${command}
    COMMAND "${CMAKE_COMMAND}" "-DWIRELINK_WLC_MANIFEST=${manifest}"
      "-DWIRELINK_WLC_EXPECTED_CONTRACT=${WIRELINK_WLC_CODEGEN_CONTRACT}"
      -P "${verifier}"
    DEPENDS ${depends} "${verifier}" VERBATIM COMMAND_EXPAND_LISTS)
  add_library(${WLC_TARGET} STATIC "${output}/${module}.c")
  target_include_directories(${WLC_TARGET} PUBLIC "${output}")
  target_compile_features(${WLC_TARGET} PUBLIC c_std_11)
  if(TARGET Wirelink::endpoint)
    if(node_count GREATER 0)
      target_link_libraries(${WLC_TARGET} PUBLIC Wirelink::endpoint ${connectors})
    else()
      target_link_libraries(${WLC_TARGET} PUBLIC Wirelink::types)
    endif()
  elseif(DEFINED ZEPHYR_BASE AND TARGET wirelink)
    if(node_count GREATER 0 AND NOT CONFIG_WIRELINK)
      message(FATAL_ERROR "Generated node requires CONFIG_WIRELINK=y")
    endif()
    foreach(connector IN LISTS connectors)
      if(connector STREQUAL "Wirelink::stream_cobs_crc16" AND NOT CONFIG_WIRELINK_STREAM_COBS_CRC16)
        message(FATAL_ERROR "COBS node requires CONFIG_WIRELINK_STREAM_COBS_CRC16=y")
      elseif(connector STREQUAL "Wirelink::stream_length16_none" AND NOT CONFIG_WIRELINK_STREAM_LENGTH16_NONE)
        message(FATAL_ERROR "Length16 node requires CONFIG_WIRELINK_STREAM_LENGTH16_NONE=y")
      endif()
    endforeach()
    target_link_libraries(${WLC_TARGET} PUBLIC wirelink zephyr_interface)
  else()
    message(FATAL_ERROR "Load the Wirelink core package or Zephyr module before generating C")
  endif()
  set_property(TARGET ${WLC_TARGET} PROPERTY WIRELINK_WLC_GENERATED_DIR "${output}")
  set_property(TARGET ${WLC_TARGET} PROPERTY WIRELINK_WLC_SCHEMA "${schema}")
  set_property(TARGET ${WLC_TARGET} PROPERTY WIRELINK_WLC_EXECUTABLE "${compiler}")
endfunction()
function(wirelink_wlc_generate_codec)
  wirelink_wlc_generate(${ARGN})
endfunction()
