source "samples/subsys/usb/common/Kconfig.sample_usbd"
source "Kconfig.zephyr"

config SAMPLE_WIRELINK_USB_CPU_STATS
	bool "Collect ESP32-S3 USB CPU cycle telemetry"
	depends on SOC_SERIES_ESP32S3
	help
	  Enables cycle counters for Wirelink polling, echo and bulk dispatch,
	  deterministic object-sink writes, Status sends, USB service windows,
	  adapter hot paths, and the hooks used by optional local DWC2/USBD
	  benchmark instrumentation. This is off by default so the normal latency
	  sample has no additional cycle-telemetry state or update overhead.
