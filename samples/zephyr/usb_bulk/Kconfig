source "samples/subsys/usb/common/Kconfig.sample_usbd"
source "Kconfig.zephyr"

config SAMPLE_WIRELINK_USB_CPU_STATS
	bool "Collect ESP32-S3 USB CPU cycle telemetry"
	depends on SOC_SERIES_ESP32S3
	help
	  Counts the application pass (including one kernel step), adapter callbacks,
	  sink and service. Optional external driver hooks report zero when absent.
	  Output is wirelink_usb_kernel_cpu_v2; it is not the old polling observer
	  or the dedicated K4 benchmark. Atomic cycle sums are explicitly modulo32.
	  Off by default. No platform driver files are changed by this sample.
